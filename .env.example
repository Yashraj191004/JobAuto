# JobAuto — local environment template. Copy to .env and fill in.
# Nothing in .env is committed; nothing here is sent to any LLM.

# ── Optional: broader job discovery via RapidAPI JSearch ─────────────
# Leave blank to disable JSearch. ATS-based ingest (Greenhouse/Lever/Ashby
# /SimplifyJobs) keeps working without this key.
RAPIDAPI_KEY=

# ── Optional: explicit CLI commands for the LLM router ───────────────
# If left blank, JobAuto auto-detects `gemini`, `codex`, `copilot`, `claude`,
# and `gh copilot` on your PATH. Override only when your wrapper differs.
COPILOT_ASK_COMMAND=
CHATGPT_ASK_COMMAND=

# ── Optional: LLM scoring tuning ─────────────────────────────────────
# Cap on automatic batch scoring (0 = no cap).
DEFAULT_SCORE_LIMIT=0
# Per-call timeout for `gemini -p` on scoring/extraction (seconds).
GEMINI_TIMEOUT_SCORE=75
# How long to skip a provider after one timeout, in seconds.
LLM_PROVIDER_COOLDOWN_SECONDS=600
# `codex exec` knobs.
CODEX_MODEL=
CODEX_REASONING_EFFORT=low

# ── Portal account credentials ───────────────────────────────────────
# Some ATS portals (Workday/Greenhouse/etc) require account creation.
# These values are loaded only from .env. They are NEVER:
#   - written to knowledge/qa_bank.json
#   - sent to the LLM in prompts
#   - included in event detail logs
APP_PORTAL_EMAIL=
APP_PORTAL_PASSWORD=
